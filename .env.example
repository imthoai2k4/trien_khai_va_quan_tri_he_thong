# ============================================
# Biến môi trường cho hệ thống đặt vé xem phim
# Sao chép file này thành .env và thay đổi giá trị
# ============================================

# --- MySQL ---
MYSQL_DATABASE=movie_ticket
MYSQL_USER=movie_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Application ---
APP_PORT=3000
NODE_ENV=development

# --- Session / Auth ---
SESSION_SECRET=change_me_session_secret

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# --- MySQL Exporter ---
MYSQL_EXPORTER_USER=exporter
MYSQL_EXPORTER_PASSWORD=change_me_exporter
