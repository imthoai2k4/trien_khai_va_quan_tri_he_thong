# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG DÀNH CHO DOCKER COMPOSE
# Đổi tên file này thành .env trước khi chạy `docker compose up -d`
# ==============================================================================

# Application port (Chỉ dùng nội bộ giữa Nginx và App)
APP_PORT=3000

# Database (Khớp với docker-compose service `db`)
DB_HOST=db
DB_USER=root
DB_PASS=root
DB_NAME=tkpm_cinema

# JWT Secret
JWT_SECRET=super_secret_jwt_key_for_prod

# Grafana Monitoring (Task 12)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
