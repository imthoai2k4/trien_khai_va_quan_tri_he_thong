# Environment variables (chứa secrets)
.env
.env.local
.env.*.local

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/

# SSL/TLS certificates (private keys + chứng chỉ riêng)
# Bỏ qua TOÀN BỘ nội dung nginx/certs/ (không chỉ .key/.pem/.crt) để chắc chắn
# không có private key, CSR hay định dạng chứng chỉ nào bị commit.
nginx/certs/*
!nginx/certs/.gitkeep

# Cấu hình HTTPS đã bật cục bộ. Không commit vì nó tham chiếu tới chứng chỉ chỉ
# tồn tại trên máy đã tạo cert — commit sẽ làm Nginx khởi động thất bại ở máy
# khác. Bản mẫu an toàn để commit là nginx/conf.d/default-ssl.conf.example.
nginx/conf.d/default-ssl.conf

# Docker volumes data
mysql-data/
grafana-data/
prometheus-data/
loki-data/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Migration backup data (database dump + volume tarballs)
migrate/backup/*
!migrate/backup/.gitkeep

# Impeccable / AI agent config (nếu có)
.impeccable/
.claude/
