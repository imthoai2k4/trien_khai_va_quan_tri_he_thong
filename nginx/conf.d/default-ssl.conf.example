# ==============================================================================
# HTTPS tự ký cho demo cục bộ — FILE MẪU, KHÔNG ĐƯỢC NẠP TỰ ĐỘNG.
#
# Nginx chỉ nạp các file khớp `*.conf` trong /etc/nginx/conf.d. File này có đuôi
# `.example` nên KHÔNG được nạp, vì vậy repository ở trạng thái mặc định luôn
# khởi động được (chỉ HTTP) ngay cả khi chưa có chứng chỉ.
#
# CÁCH BẬT HTTPS (chi tiết xem README, mục "HTTPS tự ký cho demo"):
#   1) Tạo chứng chỉ vào nginx/certs/  ->  localhost.crt + localhost.key
#   2) copy nginx/conf.d/default-ssl.conf.example  ->  nginx/conf.d/default-ssl.conf
#   3) docker compose restart nginx
#
# Chỉ copy sang `.conf` SAU KHI chứng chỉ đã tồn tại. Nếu file này được nạp mà
# chứng chỉ chưa có, Nginx sẽ từ chối khởi động và cả website (kể cả HTTP) sẽ
# ngừng hoạt động.
#
# File `default-ssl.conf` đã được liệt kê trong .gitignore — không commit.
# ==============================================================================

server {
    listen      443 ssl;
    server_name localhost;

    # Chứng chỉ tự ký (được mount read-only từ ./nginx/certs).
    ssl_certificate     /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;

    # Chỉ bật TLS 1.2/1.3; bỏ các giao thức đã lỗi thời (SSLv3, TLS 1.0/1.1).
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:5m;
    ssl_session_timeout       1h;

    server_tokens off;
    client_max_body_size 1m;

    # --------------------------------------------------------------------------
    # Security headers — giống bản HTTP, khai báo lại vì đây là server block
    # riêng (chỉ một trong hai server block phục vụ mỗi request, nên không sinh
    # header trùng lặp trên thực tế).
    # --------------------------------------------------------------------------
    add_header X-Frame-Options        "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy        "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection       "0" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests" always;

    # HSTS: CHỈ bật ở đây vì chỉ server block này thực sự phục vụ qua HTTPS.
    # Cố ý KHÔNG dùng `includeSubDomains`/`preload` cho môi trường demo.
    # Nếu trình duyệt đã ghi nhớ HSTS mà bạn muốn tắt HTTPS, hãy xóa HSTS trong
    # cài đặt trình duyệt (chrome://net-internals/#hsts) trước khi gỡ cấu hình.
    add_header Strict-Transport-Security "max-age=31536000" always;

    # Xử lý lỗi upstream an toàn — giống bản HTTP.
    error_page 502 = @upstream_502;
    error_page 503 = @upstream_503;
    error_page 504 = @upstream_504;

    location @upstream_502 {
        default_type text/plain;
        return 502 "502 Bad Gateway - khong ket noi duoc toi dich vu ung dung.\n";
    }

    location @upstream_503 {
        default_type text/plain;
        return 503 "503 Service Unavailable - dich vu tam thoi khong kha dung.\n";
    }

    location @upstream_504 {
        default_type text/plain;
        return 504 "504 Gateway Timeout - dich vu ung dung phan hoi qua cham.\n";
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;

        proxy_connect_timeout 5s;
        proxy_send_timeout    30s;
        proxy_read_timeout    30s;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;

        proxy_intercept_errors on;
    }
}
