      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          },
          "unit": "Bps"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 },
      "id": 300,
      "title": "🗄️ 3. Cơ Sở Dữ Liệu MySQL (mysqld-exporter)",
      "type": "row"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 39 },
      "id": 30,
      "title": "Truy Vấn MySQL Mỗi Giây (QPS)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(mysql_global_status_questions[1m])",
